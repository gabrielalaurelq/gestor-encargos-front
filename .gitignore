app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Código generado (build_runner): se regenera en local y en el CI.
*.g.dart

# Firebase y firmas: los inyecta el CI desde sus secretos, nunca se versionan.
/android/app/google-services.json
*.keystore
*.jks
